#: src/Form/ConfigForm.php:44
msgid ""
"<details>\n"
"    <summary>Quick help about access levels</summary>\n"
"    <table class=\"access-levels-table\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th>Level</th>\n"
"                <th>Public item</th>\n"
"                <th>Media file</th>\n"
"                <th>Admin access request</th>\n"
"                <th>Author contact</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr>\n"
"                <th><strong>free</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Downloadable by anyone</td>\n"
"                <td>Useless</td>\n"
"                <td>Useless</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>reserved</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for anonymous; unlocked by any active bypass "
"(IP, SSO IDP, guest, CAS, LDAP, external, email regex) or by an approved "
"individual access request</td>\n"
"                <td>Yes</td>\n"
"                <td>Possible</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>protected</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for everyone; unlocked only by an approved "
"individual access request. No automatic bypass applies.</td>\n"
"                <td>Yes (mandatory)</td>\n"
"                <td>Possible</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>forbidden</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for everyone; no path through the admin access "
"request flow</td>\n"
"                <td>No</td>\n"
"                <td>Sole recourse</td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p><strong>Notice visibility</strong>: The access level and embargo "
"apply only on files and never hide the notice of a resource, that follow "
"Omeka core rules for visibility.</p>\n"
"    <p><strong>Independancy</strong>: The visibility public/private, the "
"access status and the embargo are evaluated separately. Even marked for free "
"access, a private item or media is never accessible on public side.</p>\n"
"    <p><strong>Cascade</strong>: A level set on an item set applies "
"automatically to its items and medias; a level set on an item applies to its "
"medias. When several levels apply, the strictest wins.</p>\n"
"</details>"
msgstr ""
"<details>\n"
"    <summary>Sikour buan diwar-benn al liveoù moned</summary>\n"
"    <table class=\"access-levels-table\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th>Live</th>\n"
"                <th>Pennad foran</th>\n"
"                <th>Restr media</th>\n"
"                <th>Goulenn moned merour</th>\n"
"                <th>Darempred an aozer</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr>\n"
"                <th><strong>digoust</strong></th>\n"
"                <td>Gwelus</td>\n"
"                <td>Da bellgargañ gant n'eus forzh piv</td>\n"
"                <td>Didalvez</td>\n"
"                <td>Didalvez</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>Miret</strong></th>\n"
"                <td>Gwelus</td>\n"
"                <td>Stanket evit an dizanv; digoret gant forzh peseurt "
"tremen-dre (IP, SSO IDP, kouviad, CAS, LDAP, diavaez, regex postel) pe gant "
"ur goulenn moned hiniennel aprouet</td>\n"
"                <td>Ya</td>\n"
"                <td>Posupl</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>gwarezet</strong></th>\n"
"                <td>Gwelus</td>\n"
"                <td>Stanket evit an holl ; digoret nemetken gant ur goulenn "
"moned hiniennel aprouet. N'eus tremen a-dreuz emgefre ebet.</td>\n"
"                <td>Ya (ret)</td>\n"
"                <td>Posupl</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>berzet</strong></th>\n"
"                <td>Gwelus</td>\n"
"                <td>Stanket evit an holl ; hent ebet dre ar red anveloù "
"goulenn moned ar verour</td>\n"
"                <td>Nann</td>\n"
"                <td>An diskoulm nemetañ</td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p><strong>Gwelusted ar gemennadenn</strong>: N'eo lakaet al live moned "
"hag an embargo e pleustr nemet war ar restroù, ha ne guzhont morse "
"kemennadenn un danvez a heuilh reolennoù diazez Omeka evit ar gwelusted.</"
"p>\n"
"    <p><strong>Emrenerezh</strong>: Priziet e vez ar gwelusted foran/prevez, "
"stad an digoradur hag an embargo a-zisrann. Zoken pa vez merket evit un "
"digoradur dieub, ne vez morse un elfenn pe ur media prevez hegerz eus ar tu "
"foran.</p>\n"
"    <p><strong>Kaskad</strong> : Ul live lakaet war un dastumad elfennoù a "
"dalvez ent emgefreek evit e elfennoù hag e vediaoù ; ul live lakaet war un "
"elfenn a dalvez evit he mediaoù. Pa vez meur a live o talvezout, eo an hini "
"strishañ a c'hounez.</p>\n"
"</details>"

