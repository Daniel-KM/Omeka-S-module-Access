#: src/Form/ConfigForm.php:44
msgid ""
"<details>\n"
"    <summary>Quick help about access levels</summary>\n"
"    <table class=\"access-levels-table\">\n"
"        <thead>\n"
"            <tr>\n"
"                <th>Level</th>\n"
"                <th>Public item</th>\n"
"                <th>Media file</th>\n"
"                <th>Admin access request</th>\n"
"                <th>Author contact</th>\n"
"            </tr>\n"
"        </thead>\n"
"        <tbody>\n"
"            <tr>\n"
"                <th><strong>free</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Downloadable by anyone</td>\n"
"                <td>Useless</td>\n"
"                <td>Useless</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>reserved</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for anonymous; unlocked by any active bypass "
"(IP, SSO IDP, guest, CAS, LDAP, external, email regex) or by an approved "
"individual access request</td>\n"
"                <td>Yes</td>\n"
"                <td>Possible</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>protected</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for everyone; unlocked only by an approved "
"individual access request. No automatic bypass applies.</td>\n"
"                <td>Yes (mandatory)</td>\n"
"                <td>Possible</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <th><strong>forbidden</strong></th>\n"
"                <td>Visible</td>\n"
"                <td>Blocked for everyone; no path through the admin access "
"request flow</td>\n"
"                <td>No</td>\n"
"                <td>Sole recourse</td>\n"
"            </tr>\n"
"        </tbody>\n"
"    </table>\n"
"    <p><strong>Notice visibility</strong>: The access level and embargo "
"apply only on files and never hide the notice of a resource, that follow "
"Omeka core rules for visibility.</p>\n"
"    <p><strong>Independancy</strong>: The visibility public/private, the "
"access status and the embargo are evaluated separately. Even marked for free "
"access, a private item or media is never accessible on public side.</p>\n"
"    <p><strong>Cascade</strong>: A level set on an item set applies "
"automatically to its items and medias; a level set on an item applies to its "
"medias. When several levels apply, the strictest wins.</p>\n"
"</details>"
msgstr ""

